@model TinyMvcDemo.Models.HomePageViewModel
@{
    ViewData["Title"] = "On tap LTW 2026";
}

<section class="study-shell">
    <div class="study-hero">
        <div>
            <span class="study-badge">On tap Lap trinh Web 2026</span>
            <h1>Bo bai thuc hanh HTML, CSS, JavaScript</h1>
            <p>
                Trang nay gom bai Cau 1 gioi thieu ca nhan, Cau 2 quan ly san pham bang localStorage,
                va nut tai source de mo nhanh khi di kiem tra.
            </p>
        </div>

        <div class="status-panel">
            <span>Dang online</span>
            <strong id="clock-live">--:--:--</strong>
            <small id="clock-date">Dang dong bo ngay...</small>
        </div>
    </div>

    <div class="quick-actions">
        <a class="action-button primary" href="/ontap/LONGNHATNGUYEN_CAU1.html" target="_blank" rel="noopener">
            Mo Cau 1
        </a>
        <a class="action-button primary" href="/ontap/LONGNHATNGUYEN_CAU2.html" target="_blank" rel="noopener">
            Mo Cau 2
        </a>
        <a class="action-button download" asp-controller="Download" asp-action="Source">
            Tai source .zip
        </a>
    </div>

    <div class="assignment-grid">
        <article class="assignment-card">
            <span class="assignment-number">Cau 1</span>
            <h2>Trang gioi thieu ca nhan</h2>
            <p>Anh dai dien, ten, loi chao, so thich, lien ket mang xa hoi, hover link va ngay he thong bang JavaScript.</p>
            <a href="/ontap/LONGNHATNGUYEN_CAU1.html" target="_blank" rel="noopener">Xem bai lam</a>
        </article>

        <article class="assignment-card">
            <span class="assignment-number">Cau 2</span>
            <h2>Quan ly san pham</h2>
            <p>Form nhap ma san pham 8 chu so, ten toi da 300 ky tu, so luong/don gia > 0, luu va doc bang localStorage.</p>
            <a href="/ontap/LONGNHATNGUYEN_CAU2.html" target="_blank" rel="noopener">Xem bai lam</a>
        </article>

        <article class="assignment-card">
            <span class="assignment-number">Source</span>
            <h2>Goi nop bai</h2>
            <p>File zip gom 2 file HTML doc lap va README ngan. Co the tai ve roi mo truc tiep bang trinh duyet.</p>
            <a asp-controller="Download" asp-action="Source">Tai ve ngay</a>
        </article>
    </div>

    <div class="deploy-card">
        <h2>Thong tin deploy hien tai</h2>
        <div class="deploy-table">
            <div><span>Commit</span><code>@Model.Commit</code></div>
            <div><span>Build number</span><code>@Model.BuildNumber</code></div>
            <div><span>Deployed at</span><code>@Model.DeployedAt</code></div>
            <div><span>Environment</span><code>@Model.EnvironmentName</code></div>
        </div>
    </div>
</section>

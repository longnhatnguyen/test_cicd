@model TinyMvcDemo.Models.HomePageViewModel
@{
    ViewData["Title"] = "Ôn tập LTW 2026";
}

<section class="study-shell">
    <section class="study-hero">
        <div class="hero-copy">
            <span class="study-badge">LTW 2026 Personal Lab</span>
            <h1>Bộ bài ôn tập có preview và source tải nhanh</h1>
            <p>
                Mỗi câu là một trang HTML độc lập, có CSS và JavaScript nhúng trực tiếp đúng yêu cầu đề.
                Chọn bài bên dưới để xem kết quả ngay, mở tab riêng hoặc tải source của đúng bài đó.
            </p>
        </div>

        <div class="status-panel">
            <span>Trạng thái server</span>
            <strong id="clock-live">--:--:--</strong>
            <small id="clock-date">Đang đồng bộ ngày...</small>
            <a asp-controller="Download" asp-action="Source" asp-route-id="all">Tải toàn bộ source</a>
        </div>
    </section>

    <div class="assignment-grid" id="assignment-list">
        <button class="assignment-card is-active" type="button"
                data-title="Câu 1 - Hồ sơ cá nhân"
                data-summary="Có ảnh đại diện, họ tên, lời chào, sở thích, mạng xã hội, hiệu ứng hover, xử lý DOM và ngày hệ thống bằng JavaScript."
                data-preview="/ontap/LONGNHATNGUYEN_CAU1.html"
                data-download="/Download/Source?id=cau1">
            <span class="assignment-number">Câu 1</span>
            <strong>Hồ sơ cá nhân</strong>
            <small>Trang giới thiệu giống một thẻ portfolio nhỏ, có lời chào đổi bằng JavaScript.</small>
        </button>

        <button class="assignment-card" type="button"
                data-title="Câu 2 - Dạng 1: Đăng ký tài khoản"
                data-summary="Form gồm họ tên, ngày sinh dd/mm/yyyy, email, mật khẩu, xác nhận mật khẩu; kiểm tra lỗi, lưu localStorage và hiển thị bảng."
                data-preview="/ontap/LONGNHATNGUYEN_CAU2_DANG1.html"
                data-download="/Download/Source?id=cau2-dang1">
            <span class="assignment-number">Câu 2 - Dạng 1</span>
            <strong>Đăng ký tài khoản</strong>
            <small>Giao diện như bàn tiếp nhận hồ sơ, có thống kê số tài khoản đã lưu.</small>
        </button>

        <button class="assignment-card" type="button"
                data-title="Câu 2 - Dạng 2: Quản lý sản phẩm"
                data-summary="Form gồm mã sản phẩm 8 chữ số, tên tối đa 300 ký tự, số lượng, đơn giá, chủng loại; kiểm tra lỗi, lưu localStorage và hiển thị bảng."
                data-preview="/ontap/LONGNHATNGUYEN_CAU2.html"
                data-download="/Download/Source?id=cau2-dang2">
            <span class="assignment-number">Câu 2 - Dạng 2</span>
            <strong>Quản lý sản phẩm</strong>
            <small>Bảng kho nhỏ có tổng tiền, dữ liệu mẫu, validate rõ ngay dưới từng trường.</small>
        </button>
    </div>

    <section class="result-panel">
        <div class="result-header">
            <div>
                <span class="study-badge muted">Kết quả đang xem</span>
                <h2 id="result-title">Câu 1 - Hồ sơ cá nhân</h2>
                <p id="result-summary">
                    Có ảnh đại diện, họ tên, lời chào, sở thích, mạng xã hội, hiệu ứng hover, xử lý DOM và ngày hệ thống bằng JavaScript.
                </p>
            </div>

            <div class="result-actions">
                <a id="open-result" class="action-button primary" href="/ontap/LONGNHATNGUYEN_CAU1.html" target="_blank" rel="noopener">
                    Mở tab riêng
                </a>
                <a id="download-result" class="action-button download" href="/Download/Source?id=cau1">
                    Tải source câu này
                </a>
            </div>
        </div>

        <iframe id="result-frame" title="Kết quả bài làm" src="/ontap/LONGNHATNGUYEN_CAU1.html"></iframe>
    </section>

    <section class="deploy-card">
        <h2>Thông tin deploy hiện tại</h2>
        <div class="deploy-table">
            <div><span>Commit</span><code>@Model.Commit</code></div>
            <div><span>Build number</span><code>@Model.BuildNumber</code></div>
            <div><span>Deployed at</span><code>@Model.DeployedAt</code></div>
            <div><span>Environment</span><code>@Model.EnvironmentName</code></div>
        </div>
    </section>
</section>

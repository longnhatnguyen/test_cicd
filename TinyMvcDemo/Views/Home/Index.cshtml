@model TinyMvcDemo.Models.HomePageViewModel
@{
    ViewData["Title"] = "CI/CD Demo";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <section class="clock-hero shadow-lg mb-4">
                <div class="clock-grid">
                    <div>
                        <span class="clock-badge">GitHub Actions -> GHCR -> Docker -> ASP.NET MVC</span>
                        <h1 class="display-5 fw-bold mb-3">@Model.AppName</h1>
                        <p class="lead text-light-emphasis mb-4">
                            Ban dang xem ban demo duoc auto deploy tu GitHub Actions len server Docker.
                        </p>

                        <div class="clock-meta">
                            <div>
                                <span class="clock-label">Server time</span>
                                <strong id="clock-time">--:--:--</strong>
                            </div>
                            <div>
                                <span class="clock-label">Today</span>
                                <strong id="clock-date">Dang dong bo...</strong>
                            </div>
                        </div>
                    </div>

                    <div class="clock-panel">
                        <div class="clock-ring">
                            <div class="clock-ring-core">
                                <span class="clock-caption">ONLINE NOW</span>
                                <div id="clock-live" class="clock-live">--:--:--</div>
                                <div class="clock-zone">UTC+07 / Asia-Bangkok style</div>
                            </div>
                        </div>

                        <div class="clock-uptime">
                            <span class="clock-label">Realtime ticker</span>
                            <strong id="clock-uptime">Dang khoi dong...</strong>
                        </div>
                    </div>
                </div>
            </section>

            <div class="card shadow-sm deploy-card">
                <div class="card-body p-4">
                    <h2 class="h4 mb-3">Thong tin ban deploy dang chay</h2>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <tbody>
                                <tr>
                                    <th scope="row">Commit</th>
                                    <td><code>@Model.Commit</code></td>
                                </tr>
                                <tr>
                                    <th scope="row">Build number</th>
                                    <td><code>@Model.BuildNumber</code></td>
                                </tr>
                                <tr>
                                    <th scope="row">Deployed at</th>
                                    <td><code>@Model.DeployedAt</code></td>
                                </tr>
                                <tr>
                                    <th scope="row">Environment</th>
                                    <td><code>@Model.EnvironmentName</code></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <p class="text-center text-muted mt-4 mb-0">
                Moi lan ban push len nhanh `main`, GitHub Actions se build image moi va cap nhat site dang host tren may cua ban.
            </p>
        </div>
    </div>
</div>
